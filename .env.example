# =============================================================
# AyurCare / VedaSync.ai — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it contains secrets.
# =============================================================

# Database (Neon PostgreSQL)
DATABASE_URL=                          # Neon pooled connection string (postgresql://user:pass@...pooler.../db?sslmode=require)

# Authentication Secrets
JWT_SECRET=                            # Random 48+ char secret. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_REFRESH_SECRET=                    # Random 48+ char secret, different from JWT_SECRET

# Email / SMTP (Gmail App Password)
SMTP_FROM_EMAIL=                       # e.g. prakritiai.connect@gmail.com
SMTP_PASSWORD=                         # Gmail App Password (not the regular account password)
SMTP_HOST=smtp.gmail.com               # SMTP server hostname
SMTP_PORT=587                          # SMTP port (587 for TLS)

# AI Services
GEMINI_API_KEY=                        # Google Gemini API key

# Payments (Stripe — use TEST mode keys until ready for production)
STRIPE_SECRET_KEY=                     # Stripe test secret key (sk_test_...)
STRIPE_WEBHOOK_SECRET=                 # Stripe webhook signing secret (whsec_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=    # Stripe test publishable key (pk_test_...)

# Google OAuth
GOOGLE_CLIENT_ID=                      # Google OAuth client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=          # Same as above (exposed to browser)

# Server
PORT=3000                              # Local dev server port

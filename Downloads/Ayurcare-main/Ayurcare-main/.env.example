# AyurCare Environment Configuration Template
PORT=3000
NODE_ENV=development

# Authentication Secrets
JWT_SECRET=ayurcare_super_secret_jwt_key_12345!
JWT_REFRESH_SECRET=ayurcare_super_secret_jwt_refresh_key_67890!

# Email / SMTP Configuration (Gmail)
# 1. Turn on 2-Step Verification for your Google Account.
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail address and 16-character App Password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM_EMAIL=prakritiai.connect@gmail.com
SMTP_PASSWORD=your_16_character_app_password_here

# Optional AI Engine Keys
# GEMINI_API_KEY=
# OPENAI_API_KEY=
